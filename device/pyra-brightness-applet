#!/usr/bin/python3
#
# pyra-brightness-applet — a MATE panel applet for the screen and keyboard
# backlights. Runs as the logged-in user, needs no root.
#
# WHY THIS EXISTS
#
# MATE's own brightness applet goes through mate-power-backlight-helper, which
# picks keyboard-backlight on this machine instead of the panel (see the
# header of pyra-idle-dim for the whole story). This one names both devices
# and drives each through logind, the same way pyra-idle-dim does.
#
# USING IT
#
#   click the icon           open the sliders; click it again or press Escape
#                            to close
#   Left / Right             move the focused slider one step
#   Up / Down                move focus between the screen and keyboard sliders
#   Home / End               jump to the ends of the focused slider
#   scroll on the icon       screen brightness; hold Shift for the keyboard
#
# The screen slider stops at 1, not 0. At 0 the panel is dark, and finding
# the slider again in the dark is not something to ask of anyone.
#
# INSTALLING
#
# pyra-install-helpers.sh puts this in /usr/local/libexec and adds the two
# files mate-panel and D-Bus need to find it. Then right-click the panel,
# "Add to Panel...", and pick "Pyra Brightness". It needs the
# gir1.2-matepanelapplet-4.0 package, which the installer also pulls in.
#
# It does not watch the backlights in the background. It reads them when the
# popup opens, every half second while the popup is open, and before each
# scroll step, so a change made anywhere else, pyra-idle-dim included, shows
# up without the applet costing anything while it is closed.
#
import os

import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("MatePanelApplet", "4.0")
from gi.repository import Gdk, Gio, GLib, GObject, Gtk, MatePanelApplet

FACTORY = "PyraBrightnessAppletFactory"
APPLET = "PyraBrightnessApplet"

REFRESH_MS = 500


class Backlight:
    def __init__(self, device, label, icon, minimum):
        self.device = device
        self.label = label
        self.icon = icon
        self.minimum = minimum
        self.sys = "/sys/class/backlight/" + device

    def present(self):
        return os.path.isdir(self.sys)

    def _read(self, name):
        with open(os.path.join(self.sys, name)) as f:
            return int(f.read().strip())

    def maximum(self):
        return self._read("max_brightness")

    def get(self):
        # The requested value, not actual_brightness: this is what logind
        # writes, so it is what the slider should agree with.
        return self._read("brightness")

    def set(self, bus, value):
        value = max(self.minimum, min(self.maximum(), int(value)))
        # logind lets the session owner set the brightness of its own seat's
        # devices. Writing the sysfs file directly would need root. Async,
        # so dragging a slider never waits on the system bus.
        bus.call(
            "org.freedesktop.login1",
            "/org/freedesktop/login1/session/auto",
            "org.freedesktop.login1.Session",
            "SetBrightness",
            GLib.Variant("(ssu)", ("backlight", self.device, value)),
            None, Gio.DBusCallFlags.NONE, 5000, None, self._done, None,
        )

    def _done(self, bus, result, data):
        try:
            bus.call_finish(result)
        except GLib.Error as e:
            print(f"{self.device}: SetBrightness failed: {e.message}", flush=True)


SCREEN = Backlight("backlight", "Screen", "display-brightness-symbolic", 1)
KEYBOARD = Backlight("keyboard-backlight", "Keyboard",
                     "keyboard-brightness-symbolic", 0)


class Popup:
    def __init__(self, bus, lights):
        self.bus = bus
        self.lights = lights
        self.scales = []
        self.updating = False
        self.timer = 0

        self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
        self.win.set_type_hint(Gdk.WindowTypeHint.DROPDOWN_MENU)
        self.win.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                            | Gdk.EventMask.KEY_PRESS_MASK)
        self.win.connect("key-press-event", self.on_key)
        self.win.connect("button-press-event", self.on_click)
        self.win.connect("grab-broken-event", lambda *a: self.hide())

        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.OUT)
        grid = Gtk.Grid(row_spacing=6, column_spacing=8, border_width=10)
        frame.add(grid)
        self.win.add(frame)

        for row, light in enumerate(lights):
            icon = Gtk.Image.new_from_icon_name(light.icon, Gtk.IconSize.MENU)
            name = Gtk.Label(label=light.label, xalign=0)
            adj = Gtk.Adjustment(value=light.minimum, lower=light.minimum,
                                 upper=light.maximum(), step_increment=1,
                                 page_increment=1)
            scale = Gtk.Scale(orientation=Gtk.Orientation.HORIZONTAL,
                              adjustment=adj, digits=0, hexpand=True,
                              draw_value=False)
            scale.set_size_request(200, -1)
            # The value sits in its own fixed-width label rather than the
            # scale's built-in one, which sizes itself to each device's
            # maximum and so leaves the two sliders different lengths.
            value = Gtk.Label(width_chars=2, xalign=1)
            adj.bind_property("value", value, "label",
                              GObject.BindingFlags.SYNC_CREATE,
                              lambda b, v: str(int(v)))
            scale.set_can_focus(True)
            scale.connect("value-changed", self.on_changed, light)
            # Snap drags to whole steps; there are only sixteen of them.
            scale.connect("change-value", self.on_snap)
            grid.attach(icon, 0, row, 1, 1)
            grid.attach(name, 1, row, 1, 1)
            grid.attach(scale, 2, row, 1, 1)
            grid.attach(value, 3, row, 1, 1)
            self.scales.append(scale)

        frame.show_all()

    def visible(self):
        return self.win.get_visible()

    def refresh(self):
        self.updating = True
        try:
            for light, scale in zip(self.lights, self.scales):
                try:
                    v = light.get()
                except OSError:
                    continue
                if int(scale.get_value()) != v:
                    scale.set_value(v)
        finally:
            self.updating = False
        return self.visible()

    def on_snap(self, scale, scroll, value):
        v = round(value)
        adj = scale.get_adjustment()
        v = max(adj.get_lower(), min(adj.get_upper(), v))
        if v != scale.get_value():
            scale.set_value(v)
        return True

    def on_changed(self, scale, light):
        if not self.updating:
            light.set(self.bus, scale.get_value())

    def on_key(self, win, event):
        key = event.keyval
        if key == Gdk.KEY_Escape:
            self.hide()
            return True
        if key in (Gdk.KEY_Up, Gdk.KEY_Down, Gdk.KEY_KP_Up, Gdk.KEY_KP_Down):
            # A horizontal GtkScale takes Up/Down as value changes too. Here
            # they move between the sliders instead, so that the arrow keys
            # read as a grid: left/right is the value, up/down is the row.
            focus = win.get_focus()
            i = self.scales.index(focus) if focus in self.scales else 0
            i += -1 if key in (Gdk.KEY_Up, Gdk.KEY_KP_Up) else 1
            self.scales[max(0, min(len(self.scales) - 1, i))].grab_focus()
            return True
        return False

    def on_click(self, win, event):
        # With the pointer grabbed, a click anywhere else on the screen lands
        # here with coordinates outside the window. That means "close".
        w, h = win.get_size()
        if not (0 <= event.x < w and 0 <= event.y < h):
            self.hide()
            return True
        return False

    def show(self, applet):
        self.refresh()
        self.win.realize()
        self.place(applet)
        self.win.show()
        self.scales[0].grab_focus()

        seat = Gdk.Display.get_default().get_default_seat()
        status = seat.grab(self.win.get_window(), Gdk.SeatCapabilities.ALL,
                           True, None, None, None, None)
        if status != Gdk.GrabStatus.SUCCESS:
            # Someone else holds the grab, a menu probably. Without it the
            # arrow keys go elsewhere and outside clicks never close us, so
            # do not pretend to be open.
            self.win.hide()
            return
        self.timer = GLib.timeout_add(REFRESH_MS, self.refresh)

    def hide(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        Gdk.Display.get_default().get_default_seat().ungrab()
        self.win.hide()

    def place(self, applet):
        _, ax, ay = applet.get_window().get_origin()
        alloc = applet.get_allocation()
        w, h = self.win.get_preferred_size()[1].width, \
            self.win.get_preferred_size()[1].height
        display = Gdk.Display.get_default()
        geo = display.get_monitor_at_window(applet.get_window()).get_geometry()

        orient = applet.get_orient()
        if orient == MatePanelApplet.AppletOrient.DOWN:     # panel on top
            x, y = ax + alloc.x, ay + alloc.y + alloc.height
        elif orient == MatePanelApplet.AppletOrient.UP:     # panel at bottom
            x, y = ax + alloc.x, ay + alloc.y - h
        elif orient == MatePanelApplet.AppletOrient.RIGHT:  # panel on left
            x, y = ax + alloc.x + alloc.width, ay + alloc.y
        else:                                               # panel on right
            x, y = ax + alloc.x - w, ay + alloc.y

        x = max(geo.x, min(geo.x + geo.width - w, x))
        y = max(geo.y, min(geo.y + geo.height - h, y))
        self.win.move(x, y)


def build(applet, iid, data):
    if iid != APPLET:
        return False

    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    lights = [l for l in (SCREEN, KEYBOARD) if l.present()]

    applet.set_flags(MatePanelApplet.AppletFlags.EXPAND_MINOR)
    image = Gtk.Image.new_from_icon_name(SCREEN.icon, Gtk.IconSize.MENU)
    applet.add(image)

    def resize(applet, size):
        image.set_pixel_size(max(16, size - 6))
    applet.connect("change-size", resize)
    resize(applet, applet.get_size())

    if not lights:
        applet.set_tooltip_text("No backlight devices found")
        applet.show_all()
        return True

    popup = Popup(bus, lights)

    def on_press(applet, event):
        if event.button != 1:
            return False  # leave right-click to the panel's own menu
        if popup.visible():
            popup.hide()
        else:
            popup.show(applet)
        return True

    def on_scroll(applet, event):
        if event.direction == Gdk.ScrollDirection.UP:
            step = 1
        elif event.direction == Gdk.ScrollDirection.DOWN:
            step = -1
        elif event.direction == Gdk.ScrollDirection.SMOOTH:
            dy = event.get_scroll_deltas()[2]
            if dy == 0:
                return False
            step = -1 if dy > 0 else 1
        else:
            return False
        light = SCREEN
        if event.state & Gdk.ModifierType.SHIFT_MASK and KEYBOARD.present():
            light = KEYBOARD
        try:
            light.set(bus, light.get() + step)
        except OSError:
            pass
        return True

    def on_tooltip(applet, x, y, keyboard, tooltip):
        lines = []
        for l in lights:
            try:
                lines.append(f"{l.label}: {l.get()} of {l.maximum()}")
            except OSError:
                lines.append(f"{l.label}: unreadable")
        tooltip.set_text("\n".join(lines))
        return True

    applet.add_events(Gdk.EventMask.BUTTON_PRESS_MASK
                      | Gdk.EventMask.SCROLL_MASK
                      | Gdk.EventMask.SMOOTH_SCROLL_MASK)
    applet.connect("button-press-event", on_press)
    applet.connect("scroll-event", on_scroll)
    applet.set_has_tooltip(True)
    applet.connect("query-tooltip", on_tooltip)

    applet.show_all()
    return True


if __name__ == "__main__":
    MatePanelApplet.Applet.factory_main(
        FACTORY, True, MatePanelApplet.Applet.__gtype__, build, None)
