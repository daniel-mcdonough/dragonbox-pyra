# Installed by pyra-trixie-prep.sh --release. A release image ships no ssh host
# keys, so that no two cards share them, and Debian's ssh.service does not make
# them: its `sshd -t` fails with no host key. This makes them once, before
# sshd starts, on a card that has none.
[Unit]
Description=Generate this card's SSH host keys
ConditionPathExistsGlob=!/etc/ssh/ssh_host_*_key
Before=ssh.service ssh.socket

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A
ExecStartPost=/usr/bin/sync

[Install]
WantedBy=multi-user.target
