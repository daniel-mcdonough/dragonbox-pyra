# Installed by pyra-trixie-prep.sh (fix 23). Prep removes the vendor image's ssh
# host keys, which every card written from it shares, and Debian's ssh.service
# does not make new ones: its `sshd -t` fails with no host key. This makes them
# once, before sshd starts, on a card that has none.
[Unit]
Description=Generate this card's SSH host keys
ConditionPathExistsGlob=!/etc/ssh/ssh_host_*_key
Before=ssh.service ssh.socket

[Service]
Type=oneshot
ExecStart=/usr/bin/ssh-keygen -A
ExecStartPost=/usr/bin/sync

[Install]
WantedBy=multi-user.target
