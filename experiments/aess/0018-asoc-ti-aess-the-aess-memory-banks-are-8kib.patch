From: Pyra kernel work <noreply@example.invalid>
Subject: [PATCH] ASoC: ti: aess: the AESS memory banks are 8 KiB, not 4

With 0017 the init sequence runs, and probe then dies in memcpy:

  aess 401f1000.aess: opp: no OPP data
  aess 401f1000.aess: No OPP definition
  (memcpy) from (omap_aess_load_fw_param+0x60/0xec)
           from (omap_aess_load_fw) from (omap_aess_pcm_probe+0xfc/0x1dc)

omap_aess_load_fw_param() memcpy's each of the firmware's four images into its
bank. The firmware carries PMEM 8192 and CMEM 7852 bytes. The device tree maps
both as 0x1000 -- 4 KiB -- so the copy runs off the end of the ioremap.

The banks really are 8 KiB. Writing at +0x1000 in either is retained and does
not alias to offset 0, and the full 8192 and 7852 byte images read back
byte-identical, measured on an OMAP5432 ES2.0 before any of this went into the
kernel. The dtsi had already flagged its own numbers, carrying "PMEM ?KiB" and
a "CHECKME: OMAP4 and OMAP5 may differ in memory sizes" above them.

While here, the reg sizes were each one byte short: 0xffff for a 64 KiB bank,
0xfff for a 4 KiB one. DMEM and SMEM got away with it because their images are
16384 and 21600 bytes, but PMEM needs exactly 8192, so 0x1fff would still have
been one byte too few. They are now 0x10000 and 0x2000.

The second half of this patch is that the driver should not have crashed even
with a wrong device tree. It takes the bank sizes from one file and the image
sizes from another and memcpy'd one into the other without comparing them.
omap_aess_engine_probe() now records resource_size() per bank, and
omap_aess_load_fw_param() refuses any image that does not fit, naming it:

  firmware PMEM image is 8192 bytes but the bank maps only 4096

omap_aess_load_fw() and its caller propagate the failure, so a mismatch is a
probe error rather than an oops.

Verified: `make sound/soc/ti/` exits 0, and the rebuilt DTB carries
cmem 0x2000, pmem 0x2000, dmem 0x10000 and smem 0x10000 for both the MPU and
L3 views.

--- a/arch/arm/boot/dts/omap5-l4-abe.dtsi
+++ b/arch/arm/boot/dts/omap5-l4-abe.dtsi
@@ -420,30 +420,38 @@
 			#address-cells = <1>;
 			#size-cells = <1>;
 
-			/* CHECKME: OMAP4 and OMAP5 may differ in memory sizes */
+			/*
+			 * Bank sizes, checked against the firmware and the hardware:
+			 * omap_aess-adfw.bin carries PMEM 8192 and CMEM 7852 bytes,
+			 * and writing past 4 KiB of either is retained and does not
+			 * alias, so both banks are 8 KiB. They were mapped as 4 KiB
+			 * here, which made the driver's memcpy of the firmware run
+			 * off the end of the ioremap. The reg sizes were also each
+			 * one byte short (0xffff for a 64 KiB bank).
+			 */
 			ranges = <0xf1000 0xf1000 0x1000>, /* MPU private access */
 				 <0x80000 0x80000 0x10000>, /* DMEM 64KiB - MPU */
-				 <0xa0000 0xa0000 0x1000>, /* CMEM 4KiB - MPU */
+				 <0xa0000 0xa0000 0x2000>, /* CMEM 8KiB - MPU */
 				 <0xc0000 0xc0000 0x10000>, /* SMEM 64KiB - MPU */
-				 <0xe0000 0xe0000 0x1000>, /* PMEM ?KiB - MPU */
+				 <0xe0000 0xe0000 0x2000>, /* PMEM 8KiB - MPU */
 				 <0x490f1000 0x490f1000 0x1000>, /* L3 Interconnect */
 				 <0x49080000 0x49080000 0x10000>, /* DMEM 64KiB - L3 */
-				 <0x490a0000 0x490a0000 0x1000>, /* CMEM 4KiB - L3 */
+				 <0x490a0000 0x490a0000 0x2000>, /* CMEM 8KiB - L3 */
 				 <0x490ce000 0x490c0000 0x10000>, /* SMEM 64KiB - L3 */
-				 <0x490e0000 0x490e0000 0x1000>; /* PMEM ?KiB - L3 */
+				 <0x490e0000 0x490e0000 0x2000>; /* PMEM 8KiB - L3 */
 
 			aess: aess {
 				compatible = "ti,omap4-aess";
 				reg = <0xf1000 0x3ff>, /* MPU private access */
-				      <0x80000 0xffff>, /* DMEM - MPU */
-				      <0xa0000 0xfff>, /* CMEM - MPU */
-				      <0xc0000 0xffff>, /* SMEM - MPU */
-				      <0xe0000 0xfff>, /* PMEM - MPU */
+				      <0x80000 0x10000>, /* DMEM 64KiB - MPU */
+				      <0xa0000 0x2000>, /* CMEM 8KiB - MPU */
+				      <0xc0000 0x10000>, /* SMEM 64KiB - MPU */
+				      <0xe0000 0x2000>, /* PMEM 8KiB - MPU */
 				      <0x490f1000 0x3ff>, /* L3 Interconnect */
-				      <0x49080000 0xffff>, /* DMEM - L3 */
-				      <0x490a0000 0xfff>, /* CMEM - L3 */
-				      <0x490ce000 0xffff>, /* SMEM - L3 */
-				      <0x490e0000 0xfff>; /* PMEM - L3 */
+				      <0x49080000 0x10000>, /* DMEM 64KiB - L3 */
+				      <0x490a0000 0x2000>, /* CMEM 8KiB - L3 */
+				      <0x490ce000 0x10000>, /* SMEM 64KiB - L3 */
+				      <0x490e0000 0x2000>; /* PMEM 8KiB - L3 */
 				reg-names = "mpu", "dmem", "cmem", "smem", "pmem",
 				      "dma", "dmem_dma", "cmem_dma", "smem_dma",
 				      "pmem_dma";
--- a/sound/soc/ti/aess/aess_ini.c
+++ b/sound/soc/ti/aess/aess_ini.c
@@ -178,11 +178,38 @@
  *
  * Load the different AESS memories PMEM/DMEM/SMEM/DMEM
  */
-static void omap_aess_load_fw_param(struct omap_aess *aess, const void *data)
+/*
+ * Refuse to memcpy an image into a mapping too small to hold it. The device
+ * tree used to map PMEM and CMEM as 4 KiB when the firmware carries 8192 and
+ * 7852 bytes, and the result was not an error but a memcpy off the end of the
+ * ioremap, during probe:
+ *
+ *   (memcpy) from (omap_aess_load_fw_param+0x60/0xec)
+ *            from (omap_aess_load_fw) from (omap_aess_pcm_probe+0xfc/0x1dc)
+ *
+ * The device tree is fixed, but a driver that takes sizes from one file and
+ * data from another should check them against each other rather than trust
+ * both.
+ */
+static int omap_aess_check_bank(struct omap_aess *aess, int bank,
+				const char *name, u32 size)
+{
+	if (size <= aess->io_size[bank])
+		return 0;
+
+	dev_err(aess->dev,
+		"firmware %s image is %u bytes but the bank maps only %zu\n",
+		name, size, aess->io_size[bank]);
+
+	return -EINVAL;
+}
+
+static int omap_aess_load_fw_param(struct omap_aess *aess, const void *data)
 {
 	u32 pmem_size, dmem_size, smem_size, cmem_size;
 	u32 *pmem_ptr, *dmem_ptr, *smem_ptr, *cmem_ptr;
 	u32 *fw_ptr = (u32*) data;
+	int ret;
 
 	/* Analyze FW memories banks sizes */
 	aess->firmware_version_number = *fw_ptr++;
@@ -195,10 +222,19 @@
 	dmem_ptr = cmem_ptr + (cmem_size >> 2);
 	smem_ptr = dmem_ptr + (dmem_size >> 2);
 
+	ret  = omap_aess_check_bank(aess, OMAP_AESS_BANK_PMEM, "PMEM", pmem_size);
+	ret |= omap_aess_check_bank(aess, OMAP_AESS_BANK_CMEM, "CMEM", cmem_size);
+	ret |= omap_aess_check_bank(aess, OMAP_AESS_BANK_SMEM, "SMEM", smem_size);
+	ret |= omap_aess_check_bank(aess, OMAP_AESS_BANK_DMEM, "DMEM", dmem_size);
+	if (ret)
+		return -EINVAL;
+
 	omap_aess_write(aess, OMAP_AESS_BANK_PMEM, 0, pmem_ptr, pmem_size);
 	omap_aess_write(aess, OMAP_AESS_BANK_CMEM, 0, cmem_ptr, cmem_size);
 	omap_aess_write(aess, OMAP_AESS_BANK_SMEM, 0, smem_ptr, smem_size);
 	omap_aess_write(aess, OMAP_AESS_BANK_DMEM, 0, dmem_ptr, dmem_size);
+
+	return 0;
 }
 
 /**
@@ -246,14 +282,20 @@
  * @firmware: Pointer on the AESS firmware (after the header)
  *
  */
-void omap_aess_load_fw(struct omap_aess *aess, const void *firmware)
+int omap_aess_load_fw(struct omap_aess *aess, const void *firmware)
 {
-	omap_aess_load_fw_param(aess, firmware);
+	int ret = omap_aess_load_fw_param(aess, firmware);
+
+	if (ret)
+		return ret;
+
 	omap_aess_reset_all_ports(aess);
 	omap_aess_init_gains(aess);
 	omap_aess_init_gain_ramp(aess);
 	omap_aess_build_scheduler_table(aess);
 	omap_aess_select_main_port(aess, OMAP_AESS_PHY_PORT_PDM_DL);
+
+	return 0;
 }
 
 /**
@@ -263,7 +305,8 @@
  */
 void omap_aess_reload_fw(struct omap_aess *aess, const void *firmware)
 {
-	omap_aess_load_fw_param(aess, firmware);
+	if (omap_aess_load_fw_param(aess, firmware))
+		return;
 	omap_aess_init_gain_ramp(aess);
 	omap_aess_build_scheduler_table(aess);
 	/* IRQ circular read pointer in DMEM */
--- a/sound/soc/ti/aess/aess_ini.h
+++ b/sound/soc/ti/aess/aess_ini.h
@@ -62,7 +62,7 @@
 struct omap_aess;
 
 void omap_aess_init_mem(struct omap_aess *aess, const void *fw_config);
-void omap_aess_load_fw(struct omap_aess *aess, const void *firmware);
+int omap_aess_load_fw(struct omap_aess *aess, const void *firmware);
 void omap_aess_reload_fw(struct omap_aess *aess, const void *firmware);
 
 #endif /* _AESS_INI_H_ */
--- a/sound/soc/ti/aess/omap-aess-priv.h
+++ b/sound/soc/ti/aess/omap-aess-priv.h
@@ -334,6 +334,8 @@
 
 	struct clk *clk;
 	void __iomem *io_base[OMAP_AESS_IO_RESOURCES];
+	/* so the firmware cannot be memcpy'd past the end of a mapping */
+	size_t io_size[OMAP_AESS_IO_RESOURCES];
 	u32 dmem_l4;
 	u32 dmem_l3;
 	u32 aess_config_l3;
--- a/sound/soc/ti/aess/omap-aess-core.c
+++ b/sound/soc/ti/aess/omap-aess-core.c
@@ -221,6 +221,8 @@
 		if (!aess->io_base[i])
 			return -ENOMEM;
 
+		aess->io_size[i] = resource_size(res);
+
 		if (i == 0)
 			aess->dmem_l4 = res->start;
 	}
--- a/sound/soc/ti/aess/omap-aess-pcm.c
+++ b/sound/soc/ti/aess/omap-aess-pcm.c
@@ -560,7 +560,12 @@
 		aess->mixer.route_ul[i] = omap_aess_get_label_data(aess,
 						      OMAP_AESS_BUFFER_ZERO_ID);
 
-	omap_aess_load_fw(aess, aess->fw_data);
+	ret = omap_aess_load_fw(aess, aess->fw_data);
+	if (ret < 0) {
+		dev_err(component->dev, "AESS firmware not loaded: %d\n", ret);
+		pm_runtime_put_sync(aess->dev);
+		goto out;
+	}
 
 	/* "tick" of the audio engine */
 	omap_aess_write_event_generator(aess, EVENT_TIMER);
