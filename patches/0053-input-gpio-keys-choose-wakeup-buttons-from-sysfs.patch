-ATTR_SHOW_FN(switches, EV_SW, false);
-ATTR_SHOW_FN(disabled_keys, EV_KEY, true);
-ATTR_SHOW_FN(disabled_switches, EV_SW, true);
+ATTR_SHOW_FN(keys, EV_KEY, GPIO_KEYS_ALL);
+ATTR_SHOW_FN(switches, EV_SW, GPIO_KEYS_ALL);
+ATTR_SHOW_FN(disabled_keys, EV_KEY, GPIO_KEYS_DISABLED);
+ATTR_SHOW_FN(disabled_switches, EV_SW, GPIO_KEYS_DISABLED);
+ATTR_SHOW_FN(wakeup_keys, EV_KEY, GPIO_KEYS_WAKEUP);
+ATTR_SHOW_FN(wakeup_switches, EV_SW, GPIO_KEYS_WAKEUP);
 
