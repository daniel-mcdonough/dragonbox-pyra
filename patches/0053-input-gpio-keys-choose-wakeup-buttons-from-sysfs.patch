-#define ATTR_SHOW_FN(name, type, only_disabled)				\
+/**
+ * gpio_keys_wakeup_store_helper() - choose the buttons that wake the system
+ * @dev: the gpio-keys platform device
+ * @buf: buffer from userspace that contains stringified bitmap
+ * @type: button type (%EV_KEY, %EV_SW)
+ *
+ * Buttons of @type whose code is in the bitmap become wakeup sources, and
+ * the rest of that type stop being ones.  The device tree's gpio-key,wakeup
+ * and wakeup-source properties only give the starting set.  The change
+ * takes effect at the next system suspend; power/wakeup still turns the
+ * whole device's wakeup on and off.
+ */
+static ssize_t gpio_keys_wakeup_store_helper(struct device *dev,
+					     const char *buf, unsigned int type)
+{
+	struct gpio_keys_drvdata *ddata = dev_get_drvdata(dev);
+	int n_events = get_n_events_by_type(type);
+	const unsigned long *bitmap = get_bm_events_by_type(ddata->input, type);
+	unsigned long *bits;
+	bool any = false;
+	ssize_t error;
+	int i;
+
+	bits = bitmap_zalloc(n_events, GFP_KERNEL);
+	if (!bits)
+		return -ENOMEM;
+
+	error = bitmap_parselist(buf, bits, n_events);
+	if (error)
+		goto out;
+
+	if (!bitmap_subset(bits, bitmap, n_events)) {
+		error = -EINVAL;
+		goto out;
+	}
+
+	mutex_lock(&ddata->disable_lock);
+
+	for (i = 0; i < ddata->pdata->nbuttons; i++) {
+		struct gpio_button_data *bdata = &ddata->data[i];
+
+		if (bdata->button->type == type)
+			bdata->wakeup = test_bit(*bdata->code, bits);
+		any |= bdata->wakeup;
+	}
+
+	mutex_unlock(&ddata->disable_lock);
+
+	/*
+	 * A device whose device tree named no wakeup button was never made
+	 * wakeup capable, so it would not even be asked at suspend.
+	 */
+	if (any && !device_can_wakeup(dev))
+		device_init_wakeup(dev, true);
+
+out:
+	bitmap_free(bits);
+	return error;
+}
+
+#define ATTR_SHOW_FN(name, type, filter)				\
 static ssize_t gpio_keys_show_##name(struct device *dev,		\
 				     struct device_attribute *attr,	\
 				     char *buf)				\
@@ -294,13 +366,15 @@
