Input: twl6040-vibra: drive only the motor the board has, from its start level

The Pyra has one vibration motor, on the right ("strong") channel. Its
device tree gives the left channel a motor resistance of 999999, meaning
none.  Three things follow from the stock driver:

- It sets VIBENA on both channels.  Switching the motorless left driver
  on and off clicks in the speakers (not the headphones).  Games that
  pulse rumble (Ship of Harkinian: 32 ms on, 65 ms off) click about ten
  times a second.
- The weak magnitude goes to the left channel only, so weak-only rumble
  moves nothing.  The left code also overflows int (3300 * 999999 * 85),
  which happens to come out as 0.
- The magnitude is scaled linearly onto 0..51, the cap the 3.3 V vsys
  model gives.  This motor doesn't start below code 25-32, so effects
  under about 60 % do nothing and 100 % is weak.

Treat a motor resistance of 100000 or more as no motor: never enable
that channel, and play max(strong, weak) on the one that has a motor.
Map a nonzero magnitude onto min_code..max_code, module parameters
writable at run time (defaults 32 and 56).  Writes above 60 are refused:
code 64 trips the right driver's overcurrent detection every time, 62
never did at a 3.84 V battery, and the drive rises with the battery.
max_code=0 gives the stock supply/resistance cap, computed in 64 bits;
min_code=0 gives the stock linear mapping.  enable=N stops playing
effects, for a settings switch; it takes effect at the next effect
change.
---
--- a/drivers/input/misc/twl6040-vibra.c
+++ b/drivers/input/misc/twl6040-vibra.c
@@ -28,6 +28,56 @@
 
 #define TWL6040_NUM_SUPPLIES 2
 
+/*
+ * A motor resistance this high means the board has no motor on that
+ * channel (the Pyra's device tree gives its left channel 999999).
+ */
+#define TWL6040_VIBRA_NO_MOTOR_RES	100000
+
+/*
+ * The Pyra's motor doesn't start below code 25-32, and the 3.3 V vsys
+ * model caps it at 51.  0 for either restores the stock mapping.
+ *
+ * The chip takes codes up to 100, but on the Pyra code 64 trips the
+ * right driver's overcurrent detection every time (62 never did, at a
+ * 3.84 V battery), and the drive rises with the battery voltage.  A code
+ * set from userspace can't go above 60; the default leaves room for a
+ * full battery.
+ */
+#define TWL6040_VIBRA_PARAM_MAX	60
+
+static int vibra_param_set_code(const char *val, const struct kernel_param *kp)
+{
+	unsigned int code;
+	int ret;
+
+	ret = kstrtouint(val, 0, &code);
+	if (ret)
+		return ret;
+	if (code > TWL6040_VIBRA_PARAM_MAX)
+		return -EINVAL;
+
+	*(unsigned int *)kp->arg = code;
+	return 0;
+}
+
+static const struct kernel_param_ops vibra_param_code_ops = {
+	.set = vibra_param_set_code,
+	.get = param_get_uint,
+};
+
+static unsigned int min_code = 32;
+module_param_cb(min_code, &vibra_param_code_ops, &min_code, 0644);
+MODULE_PARM_DESC(min_code, "VIBDAT code for the weakest nonzero effect, 0-60 (0: no floor)");
+
+static unsigned int max_code = 56;
+module_param_cb(max_code, &vibra_param_code_ops, &max_code, 0644);
+MODULE_PARM_DESC(max_code, "VIBDAT code for a full-magnitude effect, 0-60 (0: from the supply and resistances)");
+
+static bool enable = true;
+module_param(enable, bool, 0644);
+MODULE_PARM_DESC(enable, "Play effects (N: rumble off)");
+
 struct vibra_info {
 	struct device *dev;
 	struct input_dev *input_dev;
@@ -44,6 +94,8 @@
 	unsigned int vibrdrv_res;
 	unsigned int viblmotor_res;
 	unsigned int vibrmotor_res;
+	bool left_motor;
+	bool right_motor;
 
 	struct regulator_bulk_data supplies[TWL6040_NUM_SUPPLIES];
 
@@ -89,17 +141,25 @@
 		 * 3ms when enabling vibrator drivers to avoid false
 		 * overcurrent detection
 		 */
-		twl6040_reg_write(twl6040, TWL6040_REG_VIBCTLL,
-				  TWL6040_VIBENA | TWL6040_VIBCTRL);
-		twl6040_reg_write(twl6040, TWL6040_REG_VIBCTLR,
-				  TWL6040_VIBENA | TWL6040_VIBCTRL);
+		if (info->left_motor)
+			twl6040_reg_write(twl6040, TWL6040_REG_VIBCTLL,
+					  TWL6040_VIBENA | TWL6040_VIBCTRL);
+		if (info->right_motor)
+			twl6040_reg_write(twl6040, TWL6040_REG_VIBCTLR,
+					  TWL6040_VIBENA | TWL6040_VIBCTRL);
 		usleep_range(3000, 3500);
 	}
 
-	twl6040_reg_write(twl6040, TWL6040_REG_VIBCTLL,
-			  TWL6040_VIBENA);
-	twl6040_reg_write(twl6040, TWL6040_REG_VIBCTLR,
-			  TWL6040_VIBENA);
+	/*
+	 * Switching a driver with no motor on and off clicks in the
+	 * speakers, so leave it off.
+	 */
+	if (info->left_motor)
+		twl6040_reg_write(twl6040, TWL6040_REG_VIBCTLL,
+				  TWL6040_VIBENA);
+	if (info->right_motor)
+		twl6040_reg_write(twl6040, TWL6040_REG_VIBCTLR,
+				  TWL6040_VIBENA);
 
 	info->enabled = true;
 }
@@ -120,20 +180,30 @@
 static u8 twl6040_vibra_code(int vddvib, int vibdrv_res, int motor_res,
 			     int speed, int direction)
 {
-	int vpk, max_code;
+	unsigned int lo = READ_ONCE(min_code), hi = READ_ONCE(max_code);
+	int vpk;
 	u8 vibdat;
 
-	/* output swing */
-	vpk = (vddvib * motor_res * TWL6040_VIBRA_MOD) /
-		(100 * (vibdrv_res + motor_res));
-
-	/* 50mV per VIBDAT code step */
-	max_code = vpk / 50;
-	if (max_code > TWL6040_VIBDAT_MAX)
-		max_code = TWL6040_VIBDAT_MAX;
+	if (!hi) {
+		/* output swing; 64 bits, a no-motor resistance overflows int */
+		vpk = div_u64((u64)vddvib * motor_res * TWL6040_VIBRA_MOD,
+			      100 * (vibdrv_res + motor_res));
 
-	/* scale speed to max allowed code */
-	vibdat = (u8)((speed * max_code) / USHRT_MAX);
+		/* 50mV per VIBDAT code step */
+		hi = vpk / 50;
+	}
+	if (hi > TWL6040_VIBDAT_MAX)
+		hi = TWL6040_VIBDAT_MAX;
+	if (lo > hi)
+		lo = hi;
+
+	/* scale speed onto lo..hi, so the weakest effect still starts it */
+	if (!speed)
+		vibdat = 0;
+	else if (!lo)
+		vibdat = (u8)((speed * hi) / USHRT_MAX);
+	else
+		vibdat = (u8)(lo + ((speed - 1) * (hi - lo)) / (USHRT_MAX - 1));
 
 	/* 2's complement for direction > 180 degrees */
 	vibdat *= direction;
@@ -144,20 +214,31 @@
