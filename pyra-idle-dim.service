[Unit]
Description=Dim the screen backlight when the session goes idle
Documentation=file:/usr/local/bin/pyra-idle-dim
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/local/bin/pyra-idle-dim
Restart=on-failure
RestartSec=5
# Percent of maximum brightness to drop to when idle.
Environment=PYRA_DIM_PERCENT=20

[Install]
WantedBy=default.target
